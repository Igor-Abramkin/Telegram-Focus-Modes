+import Foundation
+
+/// The glyph and tint of a mode, the same set iOS offers for its own Focuses.
+public enum FocusModeSymbol: String, Codable, CaseIterable {
+    case work
+    case personal
+    case sleep
+    case doNotDisturb
+    case fitness
+    case reading
+    case driving
+    case gaming
+    case mindfulness
+
+    /// An SF Symbol name.
+    public var systemImageName: String {
+        switch self {
+        case .work:
+            return "briefcase.fill"
+        case .personal:
+            return "person.fill"
+        case .sleep:
+            return "bed.double.fill"
+        case .doNotDisturb:
+            return "moon.fill"
+        case .fitness:
+            return "figure.run"
+        case .reading:
+            return "book.fill"
+        case .driving:
+            return "car.fill"
+        case .gaming:
+            return "gamecontroller.fill"
+        case .mindfulness:
+            return "brain.head.profile"
+        }
+    }
+
+    public var rgbColor: UInt32 {
+        switch self {
+        case .work:
+            return 0x2fb0c7
+        case .personal:
+            return 0xaf52de
+        case .sleep:
+            return 0x30b6a4
+        case .doNotDisturb:
+            return 0x5e5ce6
+        case .fitness:
+            return 0x34c759
+        case .reading:
+            return 0xff9500
+        case .driving:
+            return 0x0a84ff
+        case .gaming:
+            return 0x007aff
+        case .mindfulness:
+            return 0x00c7be
+        }
+    }
+}
+
+/// A chat folder as a Focus rule sees it. The notification extension cannot evaluate a folder's filters (contacts,
+/// groups, "exclude muted"...), so the app stores the peers the folder held the last time it looked at it.
+public struct FocusChatFolder: Codable, Equatable, Hashable {
+    public var accountPeerId: Int64
+    public var id: Int32
+    public var title: String
+    public var emoticon: String?
+    public var peerIds: [Int64]
+
+    public init(accountPeerId: Int64, id: Int32, title: String, emoticon: String?, peerIds: [Int64]) {
+        self.accountPeerId = accountPeerId
+        self.id = id
+        self.title = title
+        self.emoticon = emoticon
+        self.peerIds = peerIds
+    }
+}
+
+/// Chats and folders a rule applies to.
+public struct FocusChatTargets: Codable, Equatable {
+    public var peerIds: [Int64]
+    public var folders: [FocusChatFolder]
+
+    public init(peerIds: [Int64] = [], folders: [FocusChatFolder] = []) {
+        self.peerIds = peerIds
+        self.folders = folders
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.peerIds = try container.decodeIfPresent([Int64].self, forKey: .peerIds) ?? []
+        self.folders = try container.decodeIfPresent([FocusChatFolder].self, forKey: .folders) ?? []
+    }
+
+    public var isEmpty: Bool {
+        return self.peerIds.isEmpty && self.folders.isEmpty
+    }
+
+    public var count: Int {
+        return self.peerIds.count + self.folders.count
+    }
+
+    public func contains(peerId: Int64) -> Bool {
+        if self.peerIds.contains(peerId) {
+            return true
+        }
+        for folder in self.folders {
+            if folder.peerIds.contains(peerId) {
+                return true
+            }
+        }
+        return false
+    }
+
+    public func containsFolder(accountPeerId: Int64, id: Int32) -> Bool {
+        return self.folders.contains(where: { $0.accountPeerId == accountPeerId && $0.id == id })
+    }
+}
+
+/// A time of the week when a mode turns on by itself. `startMinute` and `endMinute` count minutes from midnight; a
+/// range that ends before it starts runs past midnight into the next day (Mon 19:00 – Tue 09:00).
+public struct FocusSchedule: Codable, Equatable {
+    /// `Calendar` weekdays: 1 is Sunday, 7 is Saturday.
+    public var weekdays: [Int]
+    public var isAllDay: Bool
+    public var startMinute: Int32
+    public var endMinute: Int32
+
+    public init(weekdays: [Int], isAllDay: Bool, startMinute: Int32, endMinute: Int32) {
+        self.weekdays = weekdays
+        self.isAllDay = isAllDay
+        self.startMinute = startMinute
+        self.endMinute = endMinute
+    }
+
+    public static let workdays: [Int] = [2, 3, 4, 5, 6]
+    public static let weekend: [Int] = [7, 1]
+
+    public func contains(_ date: Date, calendar: Calendar) -> Bool {
+        let components = calendar.dateComponents([.weekday, .hour, .minute], from: date)
+        guard let weekday = components.weekday, let hour = components.hour, let minute = components.minute else {
+            return false
+        }
+        let previousWeekday = weekday == 1 ? 7 : weekday - 1
+        let currentMinute = Int32(hour * 60 + minute)
+
+        if self.isAllDay || self.startMinute == self.endMinute {
+            return self.weekdays.contains(weekday)
+        }
+        if self.startMinute < self.endMinute {
+            return self.weekdays.contains(weekday) && currentMinute >= self.startMinute && currentMinute < self.endMinute
+        } else {
+            if self.weekdays.contains(weekday) && currentMinute >= self.startMinute {
+                return true
+            }
+            if self.weekdays.contains(previousWeekday) && currentMinute < self.endMinute {
+                return true
+            }
+            return false
+        }
+    }
+}
+
+public struct FocusMode: Codable, Equatable {
+    public var id: Int32
+    public var title: String
+    public var symbol: FocusModeSymbol
+    /// Everything except the chats in "Always Notify" goes quiet.
+    public var silencesAllChats: Bool
+    public var silenced: FocusChatTargets
+    /// Chats and folders that disappear from the chat list while the mode is on (a folder loses its tab). They are
+    /// silenced too.
+    public var hidden: FocusChatTargets
+    public var schedules: [FocusSchedule]
+
+    public init(id: Int32, title: String, symbol: FocusModeSymbol, silencesAllChats: Bool, silenced: FocusChatTargets, hidden: FocusChatTargets = FocusChatTargets(), schedules: [FocusSchedule]) {
+        self.id = id
+        self.title = title
+        self.symbol = symbol
+        self.silencesAllChats = silencesAllChats
+        self.silenced = silenced
+        self.hidden = hidden
+        self.schedules = schedules
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.id = try container.decode(Int32.self, forKey: .id)
+        self.title = try container.decode(String.self, forKey: .title)
+        self.symbol = (try? container.decodeIfPresent(FocusModeSymbol.self, forKey: .symbol)) ?? .doNotDisturb
+        self.silencesAllChats = try container.decodeIfPresent(Bool.self, forKey: .silencesAllChats) ?? false
+        self.silenced = try container.decodeIfPresent(FocusChatTargets.self, forKey: .silenced) ?? FocusChatTargets()
+        self.hidden = try container.decodeIfPresent(FocusChatTargets.self, forKey: .hidden) ?? FocusChatTargets()
+        self.schedules = try container.decodeIfPresent([FocusSchedule].self, forKey: .schedules) ?? []
+    }
+
+    public func silences(peerId: Int64) -> Bool {
+        return self.silencesAllChats || self.silenced.contains(peerId: peerId) || self.hidden.contains(peerId: peerId)
+    }
+}
+
+/// A mode turned on by hand from Telegram. `until` is a unix time; nil means until it is turned off.
+public struct FocusManualActivation: Codable, Equatable {
+    public var modeId: Int32
+    public var until: Int32?
+
+    public init(modeId: Int32, until: Int32?) {
+        self.modeId = modeId
+        self.until = until
+    }
+}
+
+public struct FocusModesSettings: Codable, Equatable {
+    public var modes: [FocusMode]
+    /// These chats notify in every mode, and are sent as Time Sensitive so they reach you through an iOS Focus.
+    public var alwaysNotify: FocusChatTargets
+    public var manualActivation: FocusManualActivation?
+    /// Silenced chats show the muted icon in the chat list while their mode is on.
+    public var showSilencedInChatList: Bool
+    public var nextModeId: Int32
+
+    public init(modes: [FocusMode], alwaysNotify: FocusChatTargets, manualActivation: FocusManualActivation?, showSilencedInChatList: Bool, nextModeId: Int32) {
+        self.modes = modes
+        self.alwaysNotify = alwaysNotify
+        self.manualActivation = manualActivation
+        self.showSilencedInChatList = showSilencedInChatList
+        self.nextModeId = nextModeId
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.modes = try container.decodeIfPresent([FocusMode].self, forKey: .modes) ?? []
+        self.alwaysNotify = try container.decodeIfPresent(FocusChatTargets.self, forKey: .alwaysNotify) ?? FocusChatTargets()
+        self.manualActivation = try container.decodeIfPresent(FocusManualActivation.self, forKey: .manualActivation)
+        self.showSilencedInChatList = try container.decodeIfPresent(Bool.self, forKey: .showSilencedInChatList) ?? true
+        let maxId = self.modes.map(\.id).max() ?? 0
+        self.nextModeId = max(try container.decodeIfPresent(Int32.self, forKey: .nextModeId) ?? 0, maxId + 1)
+    }
+
+    /// Three empty modes to start from. With no chats in them they change nothing.
+    public static let defaultSettings = FocusModesSettings(
+        modes: [
+            FocusMode(id: 1, title: "Work", symbol: .work, silencesAllChats: false, silenced: FocusChatTargets(), schedules: []),
+            FocusMode(id: 2, title: "Personal", symbol: .personal, silencesAllChats: false, silenced: FocusChatTargets(), schedules: []),
+            FocusMode(id: 3, title: "Sleep", symbol: .sleep, silencesAllChats: true, silenced: FocusChatTargets(), schedules: [])
+        ],
+        alwaysNotify: FocusChatTargets(),
+        manualActivation: nil,
+        showSilencedInChatList: true,
+        nextModeId: 4
+    )
+
+    public func mode(id: Int32) -> FocusMode? {
+        return self.modes.first(where: { $0.id == id })
+    }
+
+    public mutating func updateMode(id: Int32, _ f: (inout FocusMode) -> Void) {
+        if let index = self.modes.firstIndex(where: { $0.id == id }) {
+            f(&self.modes[index])
+        }
+    }
+
+    public mutating func addMode(title: String, symbol: FocusModeSymbol) -> Int32 {
+        let id = self.nextModeId
+        self.nextModeId += 1
+        self.modes.append(FocusMode(id: id, title: title, symbol: symbol, silencesAllChats: false, silenced: FocusChatTargets(), schedules: []))
+        return id
+    }
+
+    public mutating func removeMode(id: Int32) {
+        self.modes.removeAll(where: { $0.id == id })
+        if self.manualActivation?.modeId == id {
+            self.manualActivation = nil
+        }
+    }
+}
+
+/// What the iOS Focus Filter last told Telegram. Written by the filter, separately from the settings, so a Focus that
+/// turns on while the settings screen is open cannot overwrite an edit.
+public struct FocusSystemState: Codable, Equatable {
+    public var modeId: Int32?
+    public var updatedAt: Double
+
+    public init(modeId: Int32?, updatedAt: Double) {
+        self.modeId = modeId
+        self.updatedAt = updatedAt
+    }
+
+    public static let empty = FocusSystemState(modeId: nil, updatedAt: 0.0)
+}
diff --git a/submodules/FocusModes/Sources/FocusModesStore.swift b/submodules/FocusModes/Sources/FocusModesStore.swift
