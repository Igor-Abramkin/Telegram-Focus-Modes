index 00000000..746a7de9
--- /dev/null
+++ b/submodules/FocusModes/Sources/FocusModesStore.swift
@@ -0,0 +1,99 @@
+import Foundation
+
+/// Reads and writes the Focus Modes files under the app group root (`<group>/telegram-data`), the same directory the
+/// app, the Notification Service extension and the Focus Filter all open. JSON files rather than the account manager
+/// database: the Focus Filter runs in a background launch where opening the database is not worth it, and the
+/// extension reads them with a single file read.
+public enum FocusModesStore {
+    /// Posted in-process after either file is written. A Darwin notification with the same name reaches the other
+    /// processes of the app group.
+    public static let didChangeNotificationName = "org.telegram.Telegram.FocusModesDidChange"
+
+    public static func settingsPath(rootPath: String) -> String {
+        return rootPath + "/focus-modes.json"
+    }
+
+    public static func systemStatePath(rootPath: String) -> String {
+        return rootPath + "/focus-modes-system.json"
+    }
+
+    /// `<group container>/telegram-data` for a process that knows only the app group, as the Focus Filter does.
+    public static func rootPath(appGroupIdentifier: String) -> String? {
+        guard let url = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: appGroupIdentifier) else {
+            return nil
+        }
+        return url.path + "/telegram-data"
+    }
+
+    /// `group.ph.telegra.Telegraph` for the app and for any of its extensions.
+    public static func appGroupIdentifier(bundleIdentifier: String) -> String {
+        var baseBundleId = bundleIdentifier
+        let extensionSuffixes = [".NotificationService", ".NotificationContent", ".Share", ".SiriIntents", ".Widget", ".BroadcastUpload", ".watchkitapp"]
+        for suffix in extensionSuffixes {
+            if baseBundleId.hasSuffix(suffix) {
+                baseBundleId = String(baseBundleId.dropLast(suffix.count))
+                break
+            }
+        }
+        return "group.\(baseBundleId)"
+    }
+
+    public static func loadSettings(rootPath: String) -> FocusModesSettings {
+        guard let data = try? Data(contentsOf: URL(fileURLWithPath: self.settingsPath(rootPath: rootPath))) else {
+            return .defaultSettings
+        }
+        return (try? JSONDecoder().decode(FocusModesSettings.self, from: data)) ?? .defaultSettings
+    }
+
+    public static func loadSystemState(rootPath: String) -> FocusSystemState {
+        guard let data = try? Data(contentsOf: URL(fileURLWithPath: self.systemStatePath(rootPath: rootPath))) else {
+            return .empty
+        }
+        return (try? JSONDecoder().decode(FocusSystemState.self, from: data)) ?? .empty
+    }
+
+    public static func saveSettings(_ settings: FocusModesSettings, rootPath: String) {
+        self.write(settings, path: self.settingsPath(rootPath: rootPath))
+    }
+
+    public static func saveSystemState(_ state: FocusSystemState, rootPath: String) {
+        self.write(state, path: self.systemStatePath(rootPath: rootPath))
+    }
+
+    /// Read, change and write the settings under a lock, so two writers in this process cannot lose each other's
+    /// change. Returns the stored value.
+    @discardableResult
+    public static func updateSettings(rootPath: String, _ f: (FocusModesSettings) -> FocusModesSettings) -> FocusModesSettings {
+        self.lock.lock()
+        defer {
+            self.lock.unlock()
+        }
+        let current = self.loadSettings(rootPath: rootPath)
+        let updated = f(current)
+        if updated != current {
+            self.write(updated, path: self.settingsPath(rootPath: rootPath))
+        }
+        return updated
+    }
+
+    private static let lock = NSLock()
+
+    private static func write<T: Encodable>(_ value: T, path: String) {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        guard let data = try? encoder.encode(value) else {
+            return
+        }
+        let directory = (path as NSString).deletingLastPathComponent
+        let _ = try? FileManager.default.createDirectory(atPath: directory, withIntermediateDirectories: true, attributes: nil)
+        // Written in place: the extension and the app must be able to read the file while the device is locked
+        // (NSFileProtectionCompleteUntilFirstUserAuthentication, the container default).
+        let _ = try? data.write(to: URL(fileURLWithPath: path), options: [.atomic])
+        self.postDidChange()
+    }
+
+    public static func postDidChange() {
+        NotificationCenter.default.post(name: Notification.Name(self.didChangeNotificationName), object: nil)
+        CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), CFNotificationName(self.didChangeNotificationName as CFString), nil, nil, true)
+    }
+}
diff --git a/submodules/FocusModes/Tests/FocusModesTests.swift b/submodules/FocusModes/Tests/FocusModesTests.swift
new file mode 100644
index 00000000..fa7db011
--- /dev/null
+++ b/submodules/FocusModes/Tests/FocusModesTests.swift
@@ -0,0 +1,128 @@
+import Foundation
+import XCTest
+@testable import FocusModes
+
+final class FocusModesTests: XCTestCase {
+    private var calendar: Calendar {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone(identifier: "UTC")!
+        return calendar
+    }
+
+    /// 2026-11-09 is a Monday.
+    private func date(day: Int, hour: Int, minute: Int = 0) -> Date {
+        return self.calendar.date(from: DateComponents(year: 2026, month: 11, day: day, hour: hour, minute: minute))!
+    }
+
+    private let familyPeerId: Int64 = 100
+    private let workChatPeerId: Int64 = 200
+    private let colleaguePeerId: Int64 = 201
+    private let friendPeerId: Int64 = 300
+
+    /// Off work: the Work folder is quiet on weekday evenings and all weekend. Sleep silences everything.
+    private var settings: FocusModesSettings {
+        var settings = FocusModesSettings.defaultSettings
+        settings.alwaysNotify = FocusChatTargets(peerIds: [self.familyPeerId])
+        settings.updateMode(id: 2) { mode in
+            mode.title = "Off Work"
+            mode.silenced = FocusChatTargets(peerIds: [], folders: [
+                FocusChatFolder(accountPeerId: 1, id: 7, title: "Work", emoticon: "💼", peerIds: [self.workChatPeerId, self.colleaguePeerId])
+            ])
+            mode.schedules = [
+                FocusSchedule(weekdays: FocusSchedule.workdays, isAllDay: false, startMinute: 19 * 60, endMinute: 9 * 60),
+                FocusSchedule(weekdays: FocusSchedule.weekend, isAllDay: true, startMinute: 0, endMinute: 0)
+            ]
+        }
+        return settings
+    }
+
+    func testWorkFolderIsAudibleDuringWorkHours() {
+        let monday = self.date(day: 9, hour: 11)
+        XCTAssertNil(self.settings.activeMode(systemState: .empty, at: monday, calendar: self.calendar))
+        XCTAssertEqual(self.settings.notificationDecision(peerId: self.workChatPeerId, systemState: .empty, at: monday, calendar: self.calendar), .regular)
+    }
+
+    func testWorkFolderIsSilencedOnWeekdayEvening() {
+        let mondayEvening = self.date(day: 9, hour: 21)
+        XCTAssertEqual(self.settings.activeMode(systemState: .empty, at: mondayEvening, calendar: self.calendar)?.mode.id, 2)
+        XCTAssertEqual(self.settings.notificationDecision(peerId: self.colleaguePeerId, systemState: .empty, at: mondayEvening, calendar: self.calendar), .silenced(modeId: 2))
+        XCTAssertEqual(self.settings.notificationDecision(peerId: self.friendPeerId, systemState: .empty, at: mondayEvening, calendar: self.calendar), .regular)
+    }
+
+    func testOvernightRangeCarriesIntoNextMorning() {
+        // Tuesday 08:30 still belongs to Monday's 19:00 – 09:00.
+        XCTAssertEqual(self.settings.activeMode(systemState: .empty, at: self.date(day: 10, hour: 8, minute: 30), calendar: self.calendar)?.source, .schedule)
+        XCTAssertNil(self.settings.activeMode(systemState: .empty, at: self.date(day: 10, hour: 9), calendar: self.calendar))
+        // Friday evening, then the whole weekend.
+        XCTAssertNotNil(self.settings.activeMode(systemState: .empty, at: self.date(day: 13, hour: 22), calendar: self.calendar))
+        XCTAssertNotNil(self.settings.activeMode(systemState: .empty, at: self.date(day: 14, hour: 2), calendar: self.calendar))
+        XCTAssertNotNil(self.settings.activeMode(systemState: .empty, at: self.date(day: 15, hour: 14), calendar: self.calendar))
+        // Monday 08:00 is the tail of Sunday, which is in the weekend schedule only as an all-day range.
+        XCTAssertNil(self.settings.activeMode(systemState: .empty, at: self.date(day: 16, hour: 8), calendar: self.calendar))
+    }
+
+    func testAlwaysNotifyWinsOverSilenceAll() {
+        let systemState = FocusSystemState(modeId: 3, updatedAt: 0.0)
+        let monday = self.date(day: 9, hour: 11)
+        XCTAssertEqual(self.settings.activeMode(systemState: systemState, at: monday, calendar: self.calendar)?.source, .systemFocus)
+        XCTAssertEqual(self.settings.notificationDecision(peerId: self.familyPeerId, systemState: systemState, at: monday, calendar: self.calendar), .alwaysNotify)
+        XCTAssertEqual(self.settings.notificationDecision(peerId: self.friendPeerId, systemState: systemState, at: monday, calendar: self.calendar), .silenced(modeId: 3))
+    }
+
+    func testManualActivationWinsAndExpires() {
+        var settings = self.settings
+        let monday = self.date(day: 9, hour: 11)
+        settings.manualActivation = FocusManualActivation(modeId: 1, until: Int32(monday.timeIntervalSince1970) + 3600)
+        let systemState = FocusSystemState(modeId: 3, updatedAt: 0.0)
+        XCTAssertEqual(settings.activeMode(systemState: systemState, at: monday, calendar: self.calendar)?.mode.id, 1)
+        XCTAssertEqual(settings.activeMode(systemState: systemState, at: monday.addingTimeInterval(3601), calendar: self.calendar)?.mode.id, 3)
+        XCTAssertEqual(settings.nextTransitionDate(after: monday, calendar: self.calendar), monday.addingTimeInterval(3600))
+    }
+
+    func testNextTransitionFollowsSchedule() {
+        let monday = self.date(day: 9, hour: 11, minute: 15)
+        XCTAssertEqual(self.settings.nextTransitionDate(after: monday, calendar: self.calendar), self.date(day: 9, hour: 19))
+    }
+
+    func testHiddenChatsAndFoldersFollowTheActiveMode() {
+        var settings = self.settings
+        settings.alwaysNotify.peerIds.append(self.colleaguePeerId)
+        settings.updateMode(id: 2) { mode in
+            mode.hidden = mode.silenced
+            mode.silenced = FocusChatTargets(peerIds: [self.friendPeerId])
+        }
+        let mondayEvening = self.date(day: 9, hour: 21)
+        let monday = self.date(day: 9, hour: 11)
+        XCTAssertTrue(settings.isHiddenInChatList(peerId: self.workChatPeerId, systemState: .empty, at: mondayEvening, calendar: self.calendar))
+        // Always Notify keeps a chat visible even inside a hidden folder.
+        XCTAssertFalse(settings.isHiddenInChatList(peerId: self.colleaguePeerId, systemState: .empty, at: mondayEvening, calendar: self.calendar))
+        // Silenced but not hidden: stays in the list, muted.
+        XCTAssertFalse(settings.isHiddenInChatList(peerId: self.friendPeerId, systemState: .empty, at: mondayEvening, calendar: self.calendar))
+        XCTAssertEqual(settings.notificationDecision(peerId: self.friendPeerId, systemState: .empty, at: mondayEvening, calendar: self.calendar), .silenced(modeId: 2))
+        // Hidden chats are silenced too.
+        XCTAssertEqual(settings.notificationDecision(peerId: self.workChatPeerId, systemState: .empty, at: mondayEvening, calendar: self.calendar), .silenced(modeId: 2))
+        XCTAssertFalse(settings.isHiddenInChatList(peerId: self.workChatPeerId, systemState: .empty, at: monday, calendar: self.calendar))
+
+        let active = settings.activeMode(systemState: .empty, at: mondayEvening, calendar: self.calendar)?.mode
+        XCTAssertEqual(settings.hiddenFolderIds(accountPeerId: 1, activeMode: active), [7])
+        XCTAssertEqual(settings.hiddenFolderIds(accountPeerId: 2, activeMode: active), [])
+        XCTAssertEqual(self.settings.hiddenFolderIds(accountPeerId: 1, activeMode: self.settings.mode(id: 2)), [])
+    }
+
+    func testDecodesOlderFilesAndRoundTrips() throws {
+        let legacy = #"{"modes":[{"id":5,"title":"Gym"}]}"#.data(using: .utf8)!
+        let decoded = try JSONDecoder().decode(FocusModesSettings.self, from: legacy)
+        XCTAssertEqual(decoded.modes.first?.symbol, .doNotDisturb)
+        XCTAssertEqual(decoded.nextModeId, 6)
+        XCTAssertTrue(decoded.showSilencedInChatList)
+        XCTAssertEqual(decoded.modes.first?.hidden, FocusChatTargets())
+
+        let data = try JSONEncoder().encode(self.settings)
+        XCTAssertEqual(try JSONDecoder().decode(FocusModesSettings.self, from: data), self.settings)
+    }
+
+    func testStoreUsesTheAppGroupOfTheMainApp() {
+        XCTAssertEqual(FocusModesStore.appGroupIdentifier(bundleIdentifier: "ph.telegra.Telegraph"), "group.ph.telegra.Telegraph")
+        XCTAssertEqual(FocusModesStore.appGroupIdentifier(bundleIdentifier: "ph.telegra.Telegraph.NotificationService"), "group.ph.telegra.Telegraph")
+    }
+}
