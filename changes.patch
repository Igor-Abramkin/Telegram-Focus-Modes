+private func focusFolderSnapshot(context: AccountContext, folder: ChatListFilter) -> Signal<FocusChatFolder?, NoError> {
+    guard case let .filter(id, title, emoticon, _) = folder else {
+        return .single(nil)
+    }
+    return focusResolveFolderPeerIds(context: context, folder: folder)
+    |> map { peerIds -> FocusChatFolder? in
+        return FocusChatFolder(accountPeerId: context.account.peerId.toInt64(), id: id, title: title.text, emoticon: emoticon, peerIds: peerIds)
+    }
+}
+
+private func refreshedTargets(_ targets: FocusChatTargets, accountPeerId: Int64, snapshots: [Int32: FocusChatFolder], existingFolderIds: Set<Int32>) -> FocusChatTargets {
+    var targets = targets
+    targets.folders = targets.folders.compactMap { folder -> FocusChatFolder? in
+        if folder.accountPeerId != accountPeerId {
+            return folder
+        }
+        if !existingFolderIds.contains(folder.id) {
+            // The folder was deleted.
+            return nil
+        }
+        return snapshots[folder.id] ?? folder
+    }
+    return targets
+}
