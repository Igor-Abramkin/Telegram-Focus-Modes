+public func focusModesController(context: AccountContext) -> ViewController {
+    let rootPath = context.sharedContext.basePath
+
+    let statePromise = ValuePromise(FocusModesControllerState(), ignoreRepeated: true)
+    let stateValue = Atomic(value: FocusModesControllerState())
+    let updateState: ((FocusModesControllerState) -> FocusModesControllerState) -> Void = { f in
+        statePromise.set(stateValue.modify { f($0) })
+    }
+
+    var presentControllerImpl: ((ViewController) -> Void)?
+    var pushControllerImpl: ((ViewController) -> Void)?
+
+    let focusState = Promise<FocusModesState>()
+    focusState.set(focusModesState(rootPath: rootPath))
+
+    let updateSettings: (@escaping (FocusModesSettings) -> FocusModesSettings) -> Void = { f in
+        let _ = updateFocusModesSettings(rootPath: rootPath, f).start()
+    }
+
+    let arguments = FocusModesControllerArguments(context: context, turnOn: {
+        let _ = (focusState.get()
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { state in
+            presentFocusModeTurnOnSheet(context: context, settings: state.settings, present: { c in
+                presentControllerImpl?(c)
+            })
+        })
+    }, turnOff: {
+        updateSettings { settings in
+            var settings = settings
+            settings.manualActivation = nil
+            return settings
+        }
+    }, openMode: { modeId in
+        pushControllerImpl?(focusModeEditController(context: context, modeId: modeId))
+    }, addMode: {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let _ = (updateFocusModesSettings(rootPath: rootPath, { settings in
+            var settings = settings
+            let _ = settings.addMode(title: presentationData.strings.FocusModes_NewMode, symbol: .doNotDisturb)
+            return settings
+        })
+        |> deliverOnMainQueue).start(next: { settings in
+            if let mode = settings.modes.last {
+                pushControllerImpl?(focusModeEditController(context: context, modeId: mode.id, isNew: true))
+            }
+        })
+    }, addAlwaysNotify: {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let _ = (focusState.get()
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { state in
+            presentFocusTargetsPicker(context: context, title: presentationData.strings.FocusModes_AlwaysNotifyTitle, current: state.settings.alwaysNotify, push: { c in
+                pushControllerImpl?(c)
+            }, completion: { targets in
+                updateSettings { settings in
+                    var settings = settings
+                    settings.alwaysNotify = targets
+                    return settings
+                }
+            })
+        })
+    }, removeAlwaysNotifyPeer: { peerId in
+        updateSettings { settings in
+            var settings = settings
+            settings.alwaysNotify.peerIds.removeAll(where: { $0 == peerId.toInt64() })
+            return settings
+        }
+    }, removeAlwaysNotifyFolder: { folder in
+        updateSettings { settings in
+            var settings = settings
+            settings.alwaysNotify.folders.removeAll(where: { $0.accountPeerId == folder.accountPeerId && $0.id == folder.id })
+            return settings
+        }
+    }, setRevealedItem: { id, fromId in
+        updateState { state in
+            var state = state
+            if (id == nil && fromId == state.revealedItem) || (id != nil && fromId == nil) {
+                state.revealedItem = id
+            }
+            return state
+        }
+    }, updateShowMuted: { value in
+        updateSettings { settings in
+            var settings = settings
+            settings.showSilencedInChatList = value
+            return settings
+        }
+    })
+
+    let peers = focusState.get()
+    |> map { state -> [EnginePeer.Id] in
+        return state.settings.alwaysNotify.peerIds.map { EnginePeer.Id($0) }
+    }
+    |> distinctUntilChanged
+    |> mapToSignal { peerIds -> Signal<[EnginePeer.Id: EnginePeer], NoError> in
+        return context.engine.data.subscribe(EngineDataMap(peerIds.map(TelegramEngine.EngineData.Item.Peer.Peer.init(id:))))
+        |> map { peers -> [EnginePeer.Id: EnginePeer] in
+            var result: [EnginePeer.Id: EnginePeer] = [:]
+            for (id, peer) in peers {
+                if let peer {
+                    result[id] = peer
+                }
+            }
+            return result
+        }
+    }
+
+    let signal = combineLatest(queue: .mainQueue(), context.sharedContext.presentationData, focusState.get(), statePromise.get(), peers)
+    |> map { presentationData, state, controllerState, peers -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let controllerStateValue = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(presentationData.strings.FocusModes_Title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: focusModesControllerEntries(presentationData: presentationData, state: state, controllerState: controllerState, peers: peers), style: .blocks, animateChanges: true)
+        return (controllerStateValue, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    presentControllerImpl = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    pushControllerImpl = { [weak controller] c in
+        (controller?.navigationController as? NavigationController)?.pushViewController(c)
+    }
+    return controller
+}
