diff --git a/submodules/FocusModes/BUILD b/submodules/FocusModes/BUILD
new file mode 100644
index 00000000..58571c75
--- /dev/null
+++ b/submodules/FocusModes/BUILD
@@ -0,0 +1,72 @@
+load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
+
+# The rules of Focus Modes and where they are stored. Foundation only: the app, the Notification Service extension and
+# the Focus Filter (App Intents) all read the same files in the app group.
+swift_library(
+    name = "FocusModes",
+    module_name = "FocusModes",
+    srcs = glob([
+        "Sources/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
+
+# The files as a signal, for the app's screens and the chat list.
+swift_library(
+    name = "FocusModesSignals",
+    module_name = "FocusModesSignals",
+    srcs = glob([
+        "Signals/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    deps = [
+        ":FocusModes",
+        "//submodules/SSignalKit/SwiftSignalKit:SwiftSignalKit",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
+
+# The Focus Filter that iOS shows in Settings > Focus > (a Focus) > Focus Filters > Telegram. Linked into the app
+# binary and passed to the app's `app_intents`, which extracts its metadata at build time.
+swift_library(
+    name = "FocusFilterIntent",
+    module_name = "FocusFilterIntent",
+    srcs = glob([
+        "Intent/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    linkopts = [
+        "-Wl,-framework,AppIntents",
+    ],
+    deps = [
+        ":FocusModes",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
+
+# Host (macOS) test. Run with `./build-input/bazel-9.2.0-darwin-arm64 test //submodules/FocusModes:FocusModesTests`.
+swift_test(
+    name = "FocusModesTests",
+    srcs = [
+        "Tests/FocusModesTests.swift",
+    ],
+    copts = [
+        "-warnings-as-errors",
+    ],
+    deps = [
+        ":FocusModes",
+    ],
+)
diff --git a/submodules/FocusModes/Intent/TelegramFocusFilter.swift b/submodules/FocusModes/Intent/TelegramFocusFilter.swift
new file mode 100644
index 00000000..7b6a9e1c
--- /dev/null
+++ b/submodules/FocusModes/Intent/TelegramFocusFilter.swift
@@ -0,0 +1,123 @@
+import Foundation
+import AppIntents
+import FocusModes
+
+private func focusModesRootPath() -> String? {
+    guard let bundleIdentifier = Bundle.main.bundleIdentifier else {
+        return nil
+    }
+    return FocusModesStore.rootPath(appGroupIdentifier: FocusModesStore.appGroupIdentifier(bundleIdentifier: bundleIdentifier))
+}
+
+@available(iOS 16.0, *)
+private func availableFocusModes() -> [TelegramFocusModeEntity] {
+    guard let rootPath = focusModesRootPath() else {
+        return []
+    }
+    return FocusModesStore.loadSettings(rootPath: rootPath).modes.map(TelegramFocusModeEntity.init(mode:))
+}
+
+/// A Telegram focus mode, as the Focus Filter's picker lists it.
+@available(iOS 16.0, *)
+public struct TelegramFocusModeEntity: AppEntity {
+    public static let typeDisplayRepresentation: TypeDisplayRepresentation = TypeDisplayRepresentation(name: "Telegram Focus Mode")
+    public static let defaultQuery = TelegramFocusModeQuery()
+
+    public var id: String
+    public var title: String
+    public var symbolName: String
+    public var summary: String
+
+    public init(id: String, title: String, symbolName: String, summary: String) {
+        self.id = id
+        self.title = title
+        self.symbolName = symbolName
+        self.summary = summary
+    }
+
+    init(mode: FocusMode) {
+        let summary: String
+        if mode.silencesAllChats {
+            summary = "Silences all chats"
+        } else if mode.silenced.isEmpty && mode.hidden.isEmpty {
+            summary = "No chats silenced yet"
+        } else {
+            func describe(_ targets: FocusChatTargets) -> String {
+                var parts: [String] = []
+                if !targets.folders.isEmpty {
+                    parts.append(targets.folders.map(\.title).joined(separator: ", "))
+                }
+                if !targets.peerIds.isEmpty {
+                    parts.append(targets.peerIds.count == 1 ? "1 chat" : "\(targets.peerIds.count) chats")
+                }
+                return parts.joined(separator: " and ")
+            }
+            var sentences: [String] = []
+            if !mode.hidden.isEmpty {
+                sentences.append("Hides " + describe(mode.hidden))
+            }
+            if !mode.silenced.isEmpty {
+                sentences.append("Silences " + describe(mode.silenced))
+            }
+            summary = sentences.joined(separator: ". ")
+        }
+        self.init(id: "\(mode.id)", title: mode.title, symbolName: mode.symbol.systemImageName, summary: summary)
+    }
+
+    public var displayRepresentation: DisplayRepresentation {
+        return DisplayRepresentation(
+            title: "\(self.title)",
+            subtitle: "\(self.summary)",
+            image: DisplayRepresentation.Image(systemName: self.symbolName)
+        )
+    }
+}
+
+@available(iOS 16.0, *)
+public struct TelegramFocusModeQuery: EntityQuery {
+    public init() {
+    }
+
+    public func entities(for identifiers: [String]) async throws -> [TelegramFocusModeEntity] {
+        return availableFocusModes().filter { identifiers.contains($0.id) }
+    }
+
+    public func suggestedEntities() async throws -> [TelegramFocusModeEntity] {
+        return availableFocusModes()
+    }
+}
+
+/// Settings > Focus > (a Focus) > Focus Filters > Telegram. iOS runs `perform()` when that Focus turns on, with the
+/// chosen mode, and again when it turns off, with the parameter at its default (no mode).
+@available(iOS 16.0, *)
+public struct TelegramFocusFilter: SetFocusFilterIntent {
+    public static let title: LocalizedStringResource = "Set Telegram Focus Mode"
+    public static let description: IntentDescription? = IntentDescription("Silence the chats and folders of a Telegram focus mode while this Focus is on. Chats in Always Notify still reach you.")
+
+    @Parameter(title: "Mode")
+    public var mode: TelegramFocusModeEntity?
+
+    public init() {
+    }
+
+    public var displayRepresentation: DisplayRepresentation {
+        if let mode = self.mode {
+            return DisplayRepresentation(
+                title: "\(mode.title)",
+                subtitle: "\(mode.summary)",
+                image: DisplayRepresentation.Image(systemName: mode.symbolName)
+            )
+        } else {
+            return DisplayRepresentation(title: "Choose a Telegram focus mode")
+        }
+    }
+
+    public func perform() async throws -> some IntentResult {
+        guard let rootPath = focusModesRootPath() else {
+            return .result()
+        }
+        let modeId = self.mode.flatMap { Int32($0.id) }
+        FocusModesStore.saveSystemState(FocusSystemState(modeId: modeId, updatedAt: Date().timeIntervalSince1970), rootPath: rootPath)
+        return .result()
+    }
+}
diff --git a/submodules/FocusModes/Signals/FocusModesSignals.swift b/submodules/FocusModes/Signals/FocusModesSignals.swift
new file mode 100644
index 00000000..aeca2b91
--- /dev/null
+++ b/submodules/FocusModes/Signals/FocusModesSignals.swift
@@ -0,0 +1,123 @@
+import Foundation
+import SwiftSignalKit
+import FocusModes
+
+/// The Focus Modes files and what they mean right now.
+public struct FocusModesState: Equatable {
+    public var settings: FocusModesSettings
+    public var systemState: FocusSystemState
+    public var activeMode: FocusActiveMode?
+
+    public init(settings: FocusModesSettings, systemState: FocusSystemState, activeMode: FocusActiveMode?) {
+        self.settings = settings
+        self.systemState = systemState
+        self.activeMode = activeMode
+    }
+
+    public func isSilenced(peerId: Int64) -> Bool {
+        guard let activeMode = self.activeMode else {
+            return false
+        }
+        if self.settings.alwaysNotify.contains(peerId: peerId) {
+            return false
+        }
+        return activeMode.mode.silences(peerId: peerId)
+    }
+
+    public func isHiddenInChatList(peerId: Int64) -> Bool {
+        guard let activeMode = self.activeMode else {
+            return false
+        }
+        return self.settings.isHiddenInChatList(peerId: peerId, activeMode: activeMode.mode)
+    }
+
+    public func hiddenFolderIds(accountPeerId: Int64) -> Set<Int32> {
+        return self.settings.hiddenFolderIds(accountPeerId: accountPeerId, activeMode: self.activeMode?.mode)
+    }
+}
+
+private func currentFocusModesState(rootPath: String) -> FocusModesState {
+    let settings = FocusModesStore.loadSettings(rootPath: rootPath)
+    let systemState = FocusModesStore.loadSystemState(rootPath: rootPath)
+    return FocusModesState(settings: settings, systemState: systemState, activeMode: settings.activeMode(systemState: systemState, at: Date()))
+}
+
+private final class FocusModesDarwinObserver {
+    private let action: () -> Void
+
+    init(action: @escaping () -> Void) {
+        self.action = action
+        CFNotificationCenterAddObserver(CFNotificationCenterGetDarwinNotifyCenter(), Unmanaged.passUnretained(self).toOpaque(), { _, observer, _, _, _ in
+            guard let observer else {
+                return
+            }
+            Unmanaged<FocusModesDarwinObserver>.fromOpaque(observer).takeUnretainedValue().action()
+        }, FocusModesStore.didChangeNotificationName as CFString, nil, .deliverImmediately)
+    }
+
+    deinit {
+        CFNotificationCenterRemoveObserver(CFNotificationCenterGetDarwinNotifyCenter(), Unmanaged.passUnretained(self).toOpaque(), CFNotificationName(FocusModesStore.didChangeNotificationName as CFString), nil)
+    }
+}
+
+/// The current state, again after every write to the files (from this process or another one of the app group) and
+/// again when a schedule or a timed manual activation changes the active mode.
+public func focusModesState(rootPath: String) -> Signal<FocusModesState, NoError> {
+    return Signal { subscriber in
+        let queue = Queue.mainQueue()
+        let timer = Atomic<SwiftSignalKit.Timer?>(value: nil)
+
+        var update: (() -> Void)?
+        update = {
+            let state = currentFocusModesState(rootPath: rootPath)
+            subscriber.putNext(state)
+
+            let now = Date()
+            var delay = 60.0
+            if let next = state.settings.nextTransitionDate(after: now) {
+                delay = max(1.0, min(delay, next.timeIntervalSince(now) + 0.5))
+            }
+            let updatedTimer = SwiftSignalKit.Timer(timeout: delay, repeat: false, completion: {
+                update?()
+            }, queue: queue)
+            timer.swap(updatedTimer)?.invalidate()
+            updatedTimer.start()
+        }
+
+        let observer = NotificationCenter.default.addObserver(forName: Notification.Name(FocusModesStore.didChangeNotificationName), object: nil, queue: nil, using: { _ in
+            queue.async {
+                update?()
+            }
+        })
+        let darwinObserver = FocusModesDarwinObserver(action: {
+            queue.async {
+                update?()
+            }
+        })
+
+        queue.async {
+            update?()
+        }
+
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+            let _ = darwinObserver
+            queue.async {
+                update = nil
+                timer.swap(nil)?.invalidate()
+            }
+        }
+    }
+    |> distinctUntilChanged
+}
+
+/// Change the settings and notify every subscriber.
+public func updateFocusModesSettings(rootPath: String, _ f: @escaping (FocusModesSettings) -> FocusModesSettings) -> Signal<FocusModesSettings, NoError> {
+    return Signal { subscriber in
+        let result = FocusModesStore.updateSettings(rootPath: rootPath, f)
+        subscriber.putNext(result)
+        subscriber.putCompletion()
+        return EmptyDisposable
+    }
+    |> runOn(Queue.concurrentDefaultQueue())
+}
diff --git a/submodules/FocusModes/Sources/FocusModesEvaluation.swift b/submodules/FocusModes/Sources/FocusModesEvaluation.swift
new file mode 100644
index 00000000..a5225960
--- /dev/null
+++ b/submodules/FocusModes/Sources/FocusModesEvaluation.swift
@@ -0,0 +1,123 @@
+import Foundation
+
+public enum FocusActivationSource: Equatable {
+    /// Turned on in Telegram. `until` is a unix time, nil means until it is turned off.
+    case manual(until: Int32?)
+    /// Turned on by an iOS Focus that has the Telegram Focus Filter.
+    case systemFocus
+    /// Turned on by one of the mode's schedules.
+    case schedule
+}
+
+public struct FocusActiveMode: Equatable {
+    public var mode: FocusMode
+    public var source: FocusActivationSource
+
+    public init(mode: FocusMode, source: FocusActivationSource) {
+        self.mode = mode
+        self.source = source
+    }
+}
+
+public enum FocusNotificationDecision: Equatable {
+    /// Nothing to change: the chat's own notification settings apply.
+    case regular
+    /// The active mode silences this chat: the notification is delivered quietly, without sound or banner.
+    case silenced(modeId: Int32)
+    /// The chat is in Always Notify: delivered as Time Sensitive so it passes through an iOS Focus too.
+    case alwaysNotify
+}
+
+public extension FocusModesSettings {
+    /// The mode in effect at `date`. A mode turned on by hand wins, then the one the iOS Focus picked, then the first
+    /// mode whose schedule covers `date`.
+    func activeMode(systemState: FocusSystemState, at date: Date, calendar: Calendar = .current) -> FocusActiveMode? {
+        let timestamp = Int32(date.timeIntervalSince1970)
+        if let manualActivation = self.manualActivation, let mode = self.mode(id: manualActivation.modeId) {
+            if let until = manualActivation.until {
+                if timestamp < until {
+                    return FocusActiveMode(mode: mode, source: .manual(until: until))
+                }
+            } else {
+                return FocusActiveMode(mode: mode, source: .manual(until: nil))
+            }
+        }
+        if let modeId = systemState.modeId, let mode = self.mode(id: modeId) {
+            return FocusActiveMode(mode: mode, source: .systemFocus)
+        }
+        for mode in self.modes {
+            if mode.schedules.contains(where: { $0.contains(date, calendar: calendar) }) {
+                return FocusActiveMode(mode: mode, source: .schedule)
+            }
+        }
+        return nil
+    }
+
+    func notificationDecision(peerId: Int64, systemState: FocusSystemState, at date: Date, calendar: Calendar = .current) -> FocusNotificationDecision {
+        if self.alwaysNotify.contains(peerId: peerId) {
+            return .alwaysNotify
+        }
+        guard let activeMode = self.activeMode(systemState: systemState, at: date, calendar: calendar) else {
+            return .regular
+        }
+        if activeMode.mode.silences(peerId: peerId) {
+            return .silenced(modeId: activeMode.mode.id)
+        }
+        return .regular
+    }
+
+    /// Whether the active mode hides `peerId` from the chat list. Chats in Always Notify stay visible.
+    func isHiddenInChatList(peerId: Int64, systemState: FocusSystemState, at date: Date, calendar: Calendar = .current) -> Bool {
+        guard let activeMode = self.activeMode(systemState: systemState, at: date, calendar: calendar) else {
+            return false
+        }
+        return self.isHiddenInChatList(peerId: peerId, activeMode: activeMode.mode)
+    }
+
+    func isHiddenInChatList(peerId: Int64, activeMode: FocusMode) -> Bool {
+        if self.alwaysNotify.contains(peerId: peerId) {
+            return false
+        }
+        return activeMode.hidden.contains(peerId: peerId)
+    }
+
+    /// The folders of `accountPeerId` whose tabs the active mode hides.
+    func hiddenFolderIds(accountPeerId: Int64, activeMode: FocusMode?) -> Set<Int32> {
+        guard let activeMode else {
+            return Set()
+        }
+        return Set(activeMode.hidden.folders.filter { $0.accountPeerId == accountPeerId }.map(\.id))
+    }
+
+    /// Whether the chat list should show `peerId` as muted right now.
+    func isSilenced(peerId: Int64, systemState: FocusSystemState, at date: Date, calendar: Calendar = .current) -> Bool {
+        if case .silenced = self.notificationDecision(peerId: peerId, systemState: systemState, at: date, calendar: calendar) {
+            return true
+        }
+        return false
+    }
+
+    /// The next moment the answer of `activeMode` can change because of a schedule or a timed manual activation, so a
+    /// screen showing it knows when to look again. Checked minute by minute over the coming week.
+    func nextTransitionDate(after date: Date, calendar: Calendar = .current) -> Date? {
+        var candidates: [Date] = []
+        if let until = self.manualActivation?.until, Double(until) > date.timeIntervalSince1970 {
+            candidates.append(Date(timeIntervalSince1970: Double(until)))
+        }
+        let hasSchedules = self.modes.contains(where: { !$0.schedules.isEmpty })
+        if hasSchedules {
+            let startOfMinute = calendar.dateInterval(of: .minute, for: date)?.start ?? date
+            let initial = self.modes.map { mode in mode.schedules.contains(where: { $0.contains(date, calendar: calendar) }) }
+            var probe = startOfMinute
+            for _ in 0 ..< (7 * 24 * 60) {
+                probe = probe.addingTimeInterval(60.0)
+                let current = self.modes.map { mode in mode.schedules.contains(where: { $0.contains(probe, calendar: calendar) }) }
+                if current != initial {
+                    candidates.append(probe)
+                    break
+                }
+            }
+        }
+        return candidates.min()
+    }
+}
