+func focusModeEditController(context: AccountContext, modeId: Int32, isNew: Bool = false) -> ViewController {
+    let rootPath = context.sharedContext.basePath
+
+    let statePromise = ValuePromise(FocusModeEditControllerState(), ignoreRepeated: true)
+    let stateValue = Atomic(value: FocusModeEditControllerState())
+    let updateState: ((FocusModeEditControllerState) -> FocusModeEditControllerState) -> Void = { f in
+        statePromise.set(stateValue.modify { f($0) })
+    }
+
+    var presentControllerImpl: ((ViewController) -> Void)?
+    var pushControllerImpl: ((ViewController) -> Void)?
+    var dismissImpl: (() -> Void)?
+
+    let focusState = Promise<FocusModesState>()
+    focusState.set(focusModesState(rootPath: rootPath))
+
+    let updateMode: (@escaping (inout FocusMode) -> Void) -> Void = { f in
+        let _ = updateFocusModesSettings(rootPath: rootPath, { settings in
+            var settings = settings
+            settings.updateMode(id: modeId, f)
+            return settings
+        }).start()
+    }
+
+    let openSchedule: (Int) -> Void = { index in
+        pushControllerImpl?(focusScheduleController(context: context, modeId: modeId, scheduleIndex: index))
+    }
+
+    let arguments = FocusModeEditControllerArguments(context: context, updateTitle: { title in
+        updateMode { mode in
+            mode.title = title
+        }
+    }, updateSymbol: { symbol in
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        updateMode { mode in
+            // A new mode takes the name of its first icon, until it is named.
+            if mode.title == presentationData.strings.FocusModes_NewMode || FocusModeSymbol.allCases.contains(where: { focusModeSymbolTitle($0, strings: presentationData.strings) == mode.title }) {
+                mode.title = focusModeSymbolTitle(symbol, strings: presentationData.strings)
+            }
+            mode.symbol = symbol
+        }
+    }, updateSilenceAll: { value in
+        updateMode { mode in
+            mode.silencesAllChats = value
+        }
+    }, addTargets: {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let _ = (focusState.get()
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { state in
+            guard let mode = state.settings.mode(id: modeId) else {
+                return
+            }
+            presentFocusTargetsPicker(context: context, title: presentationData.strings.FocusModes_SilenceTitle, current: mode.silenced, push: { c in
+                pushControllerImpl?(c)
+            }, completion: { targets in
+                updateMode { mode in
+                    mode.silenced = targets
+                }
+            })
+        })
+    }, removePeer: { peerId in
+        updateMode { mode in
+            mode.silenced.peerIds.removeAll(where: { $0 == peerId.toInt64() })
+        }
+    }, removeFolder: { folder in
+        updateMode { mode in
+            mode.silenced.folders.removeAll(where: { $0.accountPeerId == folder.accountPeerId && $0.id == folder.id })
+        }
+    }, addHiddenTargets: {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let _ = (focusState.get()
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { state in
+            guard let mode = state.settings.mode(id: modeId) else {
+                return
+            }
+            presentFocusTargetsPicker(context: context, title: presentationData.strings.FocusModes_HideTitle, current: mode.hidden, push: { c in
+                pushControllerImpl?(c)
+            }, completion: { targets in
+                updateMode { mode in
+                    mode.hidden = targets
+                }
+            })
+        })
+    }, removeHiddenPeer: { peerId in
+        updateMode { mode in
+            mode.hidden.peerIds.removeAll(where: { $0 == peerId.toInt64() })
+        }
+    }, removeHiddenFolder: { folder in
+        updateMode { mode in
+            mode.hidden.folders.removeAll(where: { $0.accountPeerId == folder.accountPeerId && $0.id == folder.id })
+        }
+    }, setRevealedItem: { id, fromId in
+        updateState { state in
+            var state = state
+            if (id == nil && fromId == state.revealedItem) || (id != nil && fromId == nil) {
+                state.revealedItem = id
+            }
+            return state
+        }
+    }, openSchedule: { index in
+        openSchedule(index)
+    }, addSchedule: {
+        let _ = (updateFocusModesSettings(rootPath: rootPath, { settings in
+            var settings = settings
+            settings.updateMode(id: modeId) { mode in
+                mode.schedules.append(FocusSchedule(weekdays: FocusSchedule.workdays, isAllDay: false, startMinute: 19 * 60, endMinute: 9 * 60))
+            }
+            return settings
+        })
+        |> deliverOnMainQueue).start(next: { settings in
+            if let mode = settings.mode(id: modeId) {
+                openSchedule(mode.schedules.count - 1)
+            }
+        })
+    }, turnOn: {
+        let _ = (focusState.get()
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { state in
+            var settings = state.settings
+            settings.modes = settings.modes.filter { $0.id == modeId }
+            presentFocusModeTurnOnSheet(context: context, settings: settings, present: { c in
+                presentControllerImpl?(c)
+            })
+        })
+    }, deleteMode: {
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let actionSheet = ActionSheetController(presentationData: presentationData)
+        actionSheet.setItemGroups([
+            ActionSheetItemGroup(items: [
+                ActionSheetTextItem(title: presentationData.strings.FocusModes_DeleteModeConfirmation),
+                ActionSheetButtonItem(title: presentationData.strings.FocusModes_DeleteMode, color: .destructive, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                    let _ = updateFocusModesSettings(rootPath: rootPath, { settings in
+                        var settings = settings
+                        settings.removeMode(id: modeId)
+                        return settings
+                    }).start()
+                    dismissImpl?()
+                })
+            ]),
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                })
+            ])
+        ])
+        presentControllerImpl?(actionSheet)
+    })
+
+    let modeSignal = focusState.get()
+    |> map { state -> (FocusMode?, Bool) in
+        return (state.settings.mode(id: modeId), state.activeMode?.mode.id == modeId)
+    }
+
+    let peers = modeSignal
+    |> map { mode, _ -> [EnginePeer.Id] in
+        return ((mode?.silenced.peerIds ?? []) + (mode?.hidden.peerIds ?? [])).map { EnginePeer.Id($0) }
+    }
+    |> distinctUntilChanged
+    |> mapToSignal { peerIds -> Signal<[EnginePeer.Id: EnginePeer], NoError> in
+        return context.engine.data.subscribe(EngineDataMap(peerIds.map(TelegramEngine.EngineData.Item.Peer.Peer.init(id:))))
+        |> map { peers -> [EnginePeer.Id: EnginePeer] in
+            var result: [EnginePeer.Id: EnginePeer] = [:]
+            for (id, peer) in peers {
+                if let peer {
+                    result[id] = peer
+                }
+            }
+            return result
+        }
+    }
+
+    let signal = combineLatest(queue: .mainQueue(), context.sharedContext.presentationData, modeSignal, statePromise.get(), peers)
+    |> map { presentationData, modeAndActive, controllerState, peers -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let (mode, isActive) = modeAndActive
+        let title = mode?.title.isEmpty == false ? mode!.title : presentationData.strings.FocusModes_NewMode
+        let controllerStateValue = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back), animateChanges: false)
+        let entries: [FocusModeEditEntry] = mode.flatMap { focusModeEditEntries(presentationData: presentationData, mode: $0, isActive: isActive, controllerState: controllerState, peers: peers) } ?? []
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true)
+        return (controllerStateValue, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    presentControllerImpl = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    pushControllerImpl = { [weak controller] c in
+        (controller?.navigationController as? NavigationController)?.pushViewController(c)
+    }
+    dismissImpl = { [weak controller] in
+        let _ = controller?.navigationController?.popViewController(animated: true)
+    }
+    return controller
+}
