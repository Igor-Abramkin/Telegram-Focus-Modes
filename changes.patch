+private func focusModesControllerEntries(presentationData: PresentationData, state: FocusModesState, controllerState: FocusModesControllerState, peers: [EnginePeer.Id: EnginePeer]) -> [FocusModesEntry] {
+    let strings = presentationData.strings
+    var entries: [FocusModesEntry] = []
+
+    entries.append(.activeHeader(strings.FocusModes_ActiveHeader.uppercased()))
+    if let activeMode = state.activeMode {
+        entries.append(.activeMode(symbol: activeMode.mode.symbol, title: activeMode.mode.title, label: focusActivationString(activeMode, presentationData: presentationData)))
+        if case .manual = activeMode.source {
+            entries.append(.activeAction(strings.FocusModes_TurnOff, isTurnOff: true))
+        } else {
+            entries.append(.activeAction(strings.FocusModes_SwitchMode, isTurnOff: false))
+        }
+        entries.append(.activeInfo(strings.FocusModes_ActiveInfoOn(activeMode.mode.title).string))
+    } else {
+        entries.append(.activeMode(symbol: nil, title: strings.FocusModes_NoActiveMode, label: ""))
+        entries.append(.activeAction(strings.FocusModes_TurnOn, isTurnOff: false))
+        entries.append(.activeInfo(strings.FocusModes_ActiveInfoOff))
+    }
+
+    entries.append(.modesHeader(strings.FocusModes_ModesHeader.uppercased()))
+    for (index, mode) in state.settings.modes.enumerated() {
+        let label = state.activeMode?.mode.id == mode.id ? strings.FocusModes_On : ""
+        entries.append(.mode(index: index, mode: mode, summary: focusModeSummary(mode, presentationData: presentationData), label: label))
+    }
+    entries.append(.addMode(strings.FocusModes_AddMode))
+    entries.append(.modesInfo(strings.FocusModes_ModesInfo))
+
+    entries.append(.alwaysNotifyHeader(strings.FocusModes_AlwaysNotifyHeader.uppercased()))
+    entries.append(.addAlwaysNotify(strings.FocusModes_AddChatsOrFolders))
+    for (index, folder) in state.settings.alwaysNotify.folders.enumerated() {
+        entries.append(.alwaysNotifyFolder(index: index, folder: folder, isRevealed: controllerState.revealedItem == .folder(folder.accountPeerId, folder.id)))
+    }
+    var peerIndex = 0
+    for peerId in state.settings.alwaysNotify.peerIds {
+        if let peer = peers[EnginePeer.Id(peerId)] {
+            entries.append(.alwaysNotifyPeer(index: peerIndex, peer: peer, isRevealed: controllerState.revealedItem == .peer(peer.id)))
+            peerIndex += 1
+        }
+    }
+    entries.append(.alwaysNotifyInfo(strings.FocusModes_AlwaysNotifyInfo))
+
+    entries.append(.showMuted(strings.FocusModes_ShowMuted, state.settings.showSilencedInChatList))
+    entries.append(.showMutedInfo(strings.FocusModes_ShowMutedInfo))
+
+    return entries
+}
