+private struct FocusModeEditControllerState: Equatable {
+    var revealedItem: FocusModesEntryId?
+}
+
+private func focusModeEditEntries(presentationData: PresentationData, mode: FocusMode, isActive: Bool, controllerState: FocusModeEditControllerState, peers: [EnginePeer.Id: EnginePeer]) -> [FocusModeEditEntry] {
+    let strings = presentationData.strings
+    var entries: [FocusModeEditEntry] = []
+
+    entries.append(.nameHeader(strings.FocusModes_NameHeader.uppercased()))
+    entries.append(.name(text: mode.title, placeholder: strings.FocusModes_NamePlaceholder))
+    entries.append(.symbolHeader(strings.FocusModes_IconHeader.uppercased()))
+    entries.append(.symbol(mode.symbol))
+
+    entries.append(.silenceHeader(strings.FocusModes_SilenceHeader.uppercased()))
+    entries.append(.silenceAll(strings.FocusModes_SilenceAll, mode.silencesAllChats))
+    if mode.silencesAllChats {
+        entries.append(.silenceInfo(strings.FocusModes_SilenceAllInfo))
+    } else {
+        entries.append(.addTargets(strings.FocusModes_AddChatsOrFolders))
+        for (index, folder) in mode.silenced.folders.enumerated() {
+            entries.append(.folder(index: index, folder: folder, isRevealed: controllerState.revealedItem == .folder(folder.accountPeerId, folder.id)))
+        }
+        var peerIndex = 0
+        for peerId in mode.silenced.peerIds {
+            if let peer = peers[EnginePeer.Id(peerId)] {
+                entries.append(.peer(index: peerIndex, peer: peer, isRevealed: controllerState.revealedItem == .peer(peer.id)))
+                peerIndex += 1
+            }
+        }
+        entries.append(.silenceInfo(strings.FocusModes_SilenceInfo))
+    }
+
+    entries.append(.hideHeader(strings.FocusModes_HideHeader.uppercased()))
+    entries.append(.addHidden(strings.FocusModes_AddChatsOrFolders))
+    for (index, folder) in mode.hidden.folders.enumerated() {
+        entries.append(.hiddenFolder(index: index, folder: folder, isRevealed: controllerState.revealedItem == .hiddenFolder(folder.accountPeerId, folder.id)))
+    }
+    var hiddenPeerIndex = 0
+    for peerId in mode.hidden.peerIds {
+        if let peer = peers[EnginePeer.Id(peerId)] {
+            entries.append(.hiddenPeer(index: hiddenPeerIndex, peer: peer, isRevealed: controllerState.revealedItem == .hiddenPeer(peer.id)))
+            hiddenPeerIndex += 1
+        }
+    }
+    entries.append(.hideInfo(strings.FocusModes_HideInfo))
+
+    entries.append(.scheduleHeader(strings.FocusModes_ScheduleHeader.uppercased()))
+    for (index, schedule) in mode.schedules.enumerated() {
+        let (days, time) = focusScheduleString(schedule, presentationData: presentationData)
+        entries.append(.schedule(index: index, days: days, time: time))
+    }
+    entries.append(.addSchedule(strings.FocusModes_AddSchedule))
+    entries.append(.scheduleInfo(strings.FocusModes_ScheduleInfo))
+
+    if !isActive {
+        entries.append(.turnOn(strings.FocusModes_TurnOnNow))
+    }
+    entries.append(.delete(strings.FocusModes_DeleteMode))
+
+    return entries
+}
