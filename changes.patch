+private var focusModeIconCache: [String: UIImage] = [:]
+
+/// The mode's glyph on its colour, drawn like the other icons of Settings (30 × 30, 8 pt corners).
+func focusModeIcon(_ symbol: FocusModeSymbol, size: CGFloat = 30.0, cornerRadius: CGFloat? = nil) -> UIImage? {
+    let key = "\(symbol.rawValue)-\(size)"
+    if let image = focusModeIconCache[key] {
+        return image
+    }
+    let color = UIColor(rgb: symbol.rgbColor)
+    let side = size
+    let image = generateImage(CGSize(width: side, height: side), rotatedContext: { size, context in
+        let bounds = CGRect(origin: CGPoint(), size: size)
+        context.clear(bounds)
+
+        let path = UIBezierPath(roundedRect: bounds, cornerRadius: cornerRadius ?? (side * 8.0 / 30.0))
+        context.addPath(path.cgPath)
+        context.clip()
+
+        let colors: [CGColor] = [color.withMultipliedBrightnessBy(1.12).cgColor, color.withMultipliedBrightnessBy(0.9).cgColor]
+        var locations: [CGFloat] = [0.0, 1.0]
+        let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors as CFArray, locations: &locations)!
+        context.drawLinearGradient(gradient, start: CGPoint(x: 0.0, y: 0.0), end: CGPoint(x: 0.0, y: size.height), options: CGGradientDrawingOptions())
+
+        let configuration = UIImage.SymbolConfiguration(pointSize: floor(side * 0.5), weight: .semibold)
+        if let glyph = UIImage(systemName: symbol.systemImageName, withConfiguration: configuration)?.withTintColor(.white, renderingMode: .alwaysOriginal) {
+            let maxSide = side * 0.62
+            var glyphSize = glyph.size
+            let scale = min(1.0, maxSide / max(glyphSize.width, glyphSize.height))
+            glyphSize = CGSize(width: glyphSize.width * scale, height: glyphSize.height * scale)
+            UIGraphicsPushContext(context)
+            glyph.draw(in: CGRect(origin: CGPoint(x: floor((size.width - glyphSize.width) / 2.0), y: floor((size.height - glyphSize.height) / 2.0)), size: glyphSize))
+            UIGraphicsPopContext()
+        }
+    })
+    if let image {
+        focusModeIconCache[key] = image
+    }
+    return image
+}
