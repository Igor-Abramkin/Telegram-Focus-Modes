+/// Keeps the stored contents of the folders in Focus rules up to date while the app runs: the notification
+/// extension knows a folder only by the chats stored with it.
+public final class FocusModesFolderSynchronizer {
+    private let disposable = MetaDisposable()
+
+    public init(context: AccountContext) {
+        let rootPath = context.sharedContext.basePath
+        let accountPeerId = context.account.peerId.toInt64()
+
+        let referencedFolderIds = focusModesState(rootPath: rootPath)
+        |> map { state -> Set<Int32> in
+            var result = Set<Int32>()
+            let targets = [state.settings.alwaysNotify] + state.settings.modes.map(\.silenced) + state.settings.modes.map(\.hidden)
+            for target in targets {
+                for folder in target.folders where folder.accountPeerId == accountPeerId {
+                    result.insert(folder.id)
+                }
+            }
+            return result
+        }
+        |> distinctUntilChanged
+
+        let signal = combineLatest(referencedFolderIds, context.engine.peers.updatedChatListFilters())
+        |> mapToSignal { folderIds, filters -> Signal<(Set<Int32>, [Int32: FocusChatFolder]), NoError> in
+            let existing = Set(filters.map(\.id))
+            let referenced = filters.filter { folderIds.contains($0.id) }
+            if referenced.isEmpty {
+                return .single((existing, [:]))
+            }
+            return combineLatest(referenced.map { focusFolderSnapshot(context: context, folder: $0) })
+            |> map { snapshots -> (Set<Int32>, [Int32: FocusChatFolder]) in
+                var result: [Int32: FocusChatFolder] = [:]
+                for snapshot in snapshots {
+                    if let snapshot {
+                        result[snapshot.id] = snapshot
+                    }
+                }
+                return (existing, result)
+            }
+        }
+        |> delay(1.0, queue: Queue.concurrentDefaultQueue())
+
+        self.disposable.set(signal.start(next: { existing, snapshots in
+            FocusModesStore.updateSettings(rootPath: rootPath, { settings in
+                var settings = settings
+                settings.alwaysNotify = refreshedTargets(settings.alwaysNotify, accountPeerId: accountPeerId, snapshots: snapshots, existingFolderIds: existing)
+                for i in 0 ..< settings.modes.count {
+                    settings.modes[i].silenced = refreshedTargets(settings.modes[i].silenced, accountPeerId: accountPeerId, snapshots: snapshots, existingFolderIds: existing)
+                    settings.modes[i].hidden = refreshedTargets(settings.modes[i].hidden, accountPeerId: accountPeerId, snapshots: snapshots, existingFolderIds: existing)
+                }
+                return settings
+            })
+        }))
+    }
+
+    deinit {
+        self.disposable.dispose()
+    }
+}
+
+// MARK: - Picker
+
+private let folderCategoryIdOffset = 1_000_000
+
+/// The chat picker of the folder editor, with the account's folders listed above the chats.
+func presentFocusTargetsPicker(context: AccountContext, title: String, current: FocusChatTargets, push: @escaping (ViewController) -> Void, completion: @escaping (FocusChatTargets) -> Void) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let accountPeerId = context.account.peerId.toInt64()
+
+    let _ = (context.engine.peers.currentChatListFilters()
+    |> take(1)
+    |> deliverOnMainQueue).start(next: { filters in
+        var categories: [ChatListNodeAdditionalCategory] = []
+        var selectedCategories = Set<Int>()
+        for filter in filters {
+            guard case let .filter(id, folderTitle, _, _) = filter else {
+                continue
+            }
+            categories.append(ChatListNodeAdditionalCategory(
+                id: folderCategoryIdOffset + Int(id),
+                icon: focusFolderCategoryIcon(size: 40.0),
+                smallIcon: focusFolderCategoryIcon(size: 22.0),
+                title: folderTitle.text,
+                appearance: .option(sectionTitle: presentationData.strings.FocusModes_FoldersSection)
+            ))
+            if current.containsFolder(accountPeerId: accountPeerId, id: id) {
+                selectedCategories.insert(folderCategoryIdOffset + Int(id))
+            }
+        }
+
+        let selectedChats = Set(current.peerIds.map { EnginePeer.Id($0) })
+        let controller = context.sharedContext.makeContactMultiselectionController(ContactMultiselectionControllerParams(context: context, mode: .chatSelection(ContactMultiselectionControllerMode.ChatSelection(
+            title: title,
+            searchPlaceholder: presentationData.strings.ChatListFilter_AddChatsSearchPlaceholder,
+            selectedChats: selectedChats,
+            additionalCategories: categories.isEmpty ? nil : ContactMultiselectionControllerAdditionalCategories(categories: categories, selectedCategories: selectedCategories),
+            chatListFilters: filters
+        )), filters: [], alwaysEnabled: true, limit: nil, reachedLimit: nil))
+        controller.navigationPresentation = .modal
+        push(controller)
+
+        let _ = (controller.result
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { [weak controller] result in
+            guard case let .result(peerIds, additionalCategoryIds) = result else {
+                controller?.dismiss()
+                return
+            }
+            var updated = FocusChatTargets()
+            for peerId in peerIds {
+                if case let .peer(id) = peerId {
+                    updated.peerIds.append(id.toInt64())
+                }
+            }
+            // Folders of other accounts stay as they were.
+            updated.folders = current.folders.filter { $0.accountPeerId != accountPeerId }
+
+            let pickedFolders = filters.filter { additionalCategoryIds.contains(folderCategoryIdOffset + Int($0.id)) }
+            let snapshots: Signal<[FocusChatFolder?], NoError>
+            if pickedFolders.isEmpty {
+                snapshots = .single([])
+            } else {
+                snapshots = combineLatest(pickedFolders.map { focusFolderSnapshot(context: context, folder: $0) })
+            }
+            let _ = (snapshots
+            |> take(1)
+            |> deliverOnMainQueue).start(next: { snapshots in
+                updated.folders.append(contentsOf: snapshots.compactMap { $0 })
+                completion(updated)
+                controller?.dismiss()
+            })
+        })
+    })
+}
diff --git a/submodules/SettingsUI/Sources/Notifications/FocusModes/FocusTimeItem.swift b/submodules/SettingsUI/Sources/Notifications/FocusModes/FocusTimeItem.swift
new file mode 100644
