+private enum FocusScheduleSection: Int32 {
+    case days
+    case time
+    case actions
+}
+
+private enum FocusScheduleEntry: ItemListNodeEntry {
+    case daysHeader(String)
+    case day(index: Int, weekday: Int, title: String, isSelected: Bool)
+    case timeHeader(String)
+    case allDay(String, Bool)
+    case from(String, Int32)
+    case to(String, Int32)
+    case timeInfo(String)
+    case delete(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .daysHeader, .day:
+            return FocusScheduleSection.days.rawValue
+        case .timeHeader, .allDay, .from, .to, .timeInfo:
+            return FocusScheduleSection.time.rawValue
+        case .delete:
+            return FocusScheduleSection.actions.rawValue
+        }
+    }
+
+    var stableId: Int {
+        switch self {
+        case .daysHeader:
+            return 0
+        case let .day(index, _, _, _):
+            return 1 + index
+        case .timeHeader:
+            return 20
+        case .allDay:
+            return 21
+        case .from:
+            return 22
+        case .to:
+            return 23
+        case .timeInfo:
+            return 24
+        case .delete:
+            return 30
+        }
+    }
+
+    static func <(lhs: FocusScheduleEntry, rhs: FocusScheduleEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! FocusScheduleControllerArguments
+        switch self {
+        case let .daysHeader(text), let .timeHeader(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .day(_, weekday, title, isSelected):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .right, checked: isSelected, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.toggleWeekday(weekday)
+            })
+        case let .allDay(text, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: text, value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.updateAllDay(value)
+            })
+        case let .from(text, minute):
+            return FocusTimeItem(presentationData: presentationData, systemStyle: .glass, title: text, minute: minute, sectionId: self.section, updated: { minute in
+                arguments.updateStart(minute)
+            })
+        case let .to(text, minute):
+            return FocusTimeItem(presentationData: presentationData, systemStyle: .glass, title: text, minute: minute, sectionId: self.section, updated: { minute in
+                arguments.updateEnd(minute)
+            })
+        case let .timeInfo(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .delete(text):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: text, kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.delete()
+            })
+        }
+    }
+}
+
+private final class FocusScheduleControllerArguments {
+    let toggleWeekday: (Int) -> Void
+    let updateAllDay: (Bool) -> Void
+    let updateStart: (Int32) -> Void
+    let updateEnd: (Int32) -> Void
+    let delete: () -> Void
+
+    init(toggleWeekday: @escaping (Int) -> Void, updateAllDay: @escaping (Bool) -> Void, updateStart: @escaping (Int32) -> Void, updateEnd: @escaping (Int32) -> Void, delete: @escaping () -> Void) {
+        self.toggleWeekday = toggleWeekday
+        self.updateAllDay = updateAllDay
+        self.updateStart = updateStart
+        self.updateEnd = updateEnd
+        self.delete = delete
+    }
+}
+
+private func focusScheduleEntries(presentationData: PresentationData, schedule: FocusSchedule) -> [FocusScheduleEntry] {
+    let strings = presentationData.strings
+    var entries: [FocusScheduleEntry] = []
+
+    entries.append(.daysHeader(strings.FocusModes_DaysHeader.uppercased()))
+    let formatter = DateFormatter()
+    formatter.locale = Locale(identifier: strings.baseLanguageCode)
+    let symbols = formatter.weekdaySymbols ?? ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
+    for (index, weekday) in [2, 3, 4, 5, 6, 7, 1].enumerated() {
+        entries.append(.day(index: index, weekday: weekday, title: symbols[weekday - 1].capitalized, isSelected: schedule.weekdays.contains(weekday)))
+    }
+
+    entries.append(.timeHeader(strings.FocusModes_TimeHeader.uppercased()))
+    entries.append(.allDay(strings.FocusModes_AllDay, schedule.isAllDay))
+    if !schedule.isAllDay {
+        entries.append(.from(strings.FocusModes_From, schedule.startMinute))
+        entries.append(.to(strings.FocusModes_To, schedule.endMinute))
+        if schedule.endMinute < schedule.startMinute {
+            entries.append(.timeInfo(strings.FocusModes_ScheduleNextDayInfo(focusTimeString(minute: schedule.endMinute, dateTimeFormat: presentationData.dateTimeFormat)).string))
+        }
+    }
+    entries.append(.delete(strings.FocusModes_DeleteSchedule))
+    return entries
+}
+
+private func focusScheduleController(context: AccountContext, modeId: Int32, scheduleIndex: Int) -> ViewController {
+    let rootPath = context.sharedContext.basePath
+    var dismissImpl: (() -> Void)?
+
+    let updateSchedule: (@escaping (inout FocusSchedule) -> Void) -> Void = { f in
+        let _ = updateFocusModesSettings(rootPath: rootPath, { settings in
+            var settings = settings
+            settings.updateMode(id: modeId) { mode in
+                if scheduleIndex < mode.schedules.count {
+                    f(&mode.schedules[scheduleIndex])
+                }
+            }
+            return settings
+        }).start()
+    }
+
+    let arguments = FocusScheduleControllerArguments(toggleWeekday: { weekday in
+        updateSchedule { schedule in
+            if let index = schedule.weekdays.firstIndex(of: weekday) {
+                schedule.weekdays.remove(at: index)
+            } else {
+                schedule.weekdays.append(weekday)
+            }
+        }
+    }, updateAllDay: { value in
+        updateSchedule { schedule in
+            schedule.isAllDay = value
+        }
+    }, updateStart: { minute in
+        updateSchedule { schedule in
+            schedule.startMinute = minute
+        }
+    }, updateEnd: { minute in
+        updateSchedule { schedule in
+            schedule.endMinute = minute
+        }
+    }, delete: {
+        let _ = updateFocusModesSettings(rootPath: rootPath, { settings in
+            var settings = settings
+            settings.updateMode(id: modeId) { mode in
+                if scheduleIndex < mode.schedules.count {
+                    mode.schedules.remove(at: scheduleIndex)
+                }
+            }
+            return settings
+        }).start()
+        dismissImpl?()
+    })
+
+    let scheduleSignal = focusModesState(rootPath: rootPath)
+    |> map { state -> FocusSchedule? in
+        guard let mode = state.settings.mode(id: modeId), scheduleIndex < mode.schedules.count else {
+            return nil
+        }
+        return mode.schedules[scheduleIndex]
+    }
+    |> distinctUntilChanged
+
+    let signal = combineLatest(queue: .mainQueue(), context.sharedContext.presentationData, scheduleSignal)
+    |> map { presentationData, schedule -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(presentationData.strings.FocusModes_ScheduleTitle), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let entries = schedule.flatMap { focusScheduleEntries(presentationData: presentationData, schedule: $0) } ?? []
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    dismissImpl = { [weak controller] in
+        let _ = controller?.navigationController?.popViewController(animated: true)
+    }
+    return controller
+}
