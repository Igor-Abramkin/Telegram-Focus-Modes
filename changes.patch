+/// Turn a mode on by hand: pick the mode, then for how long.
+func presentFocusModeTurnOnSheet(context: AccountContext, settings: FocusModesSettings, present: @escaping (ViewController) -> Void) {
+    let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+    let rootPath = context.sharedContext.basePath
+
+    let activate: (Int32, Int32?) -> Void = { modeId, until in
+        let _ = updateFocusModesSettings(rootPath: rootPath, { settings in
+            var settings = settings
+            settings.manualActivation = FocusManualActivation(modeId: modeId, until: until)
+            return settings
+        }).start()
+    }
+
+    let chooseDuration: (FocusMode) -> Void = { mode in
+        let now = Date()
+        let calendar = Calendar.current
+        let hour = calendar.component(.hour, from: now)
+        let oneHour = Int32(now.timeIntervalSince1970) + 60 * 60
+
+        let eveningOrMorningTitle: String
+        let eveningOrMorningDate: Date
+        if hour < 18 {
+            eveningOrMorningTitle = presentationData.strings.FocusModes_UntilThisEvening
+            eveningOrMorningDate = calendar.date(bySettingHour: 19, minute: 0, second: 0, of: now) ?? now
+        } else {
+            eveningOrMorningTitle = presentationData.strings.FocusModes_UntilTomorrowMorning
+            let tomorrow = calendar.date(byAdding: .day, value: 1, to: now) ?? now
+            eveningOrMorningDate = calendar.date(bySettingHour: 8, minute: 0, second: 0, of: tomorrow) ?? now
+        }
+
+        let actionSheet = ActionSheetController(presentationData: presentationData)
+        actionSheet.setItemGroups([
+            ActionSheetItemGroup(items: [
+                ActionSheetTextItem(title: presentationData.strings.FocusModes_TurnOnModeTitle(mode.title).string),
+                ActionSheetButtonItem(title: presentationData.strings.FocusModes_ForOneHour, color: .accent, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                    activate(mode.id, oneHour)
+                }),
+                ActionSheetButtonItem(title: eveningOrMorningTitle, color: .accent, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                    activate(mode.id, Int32(eveningOrMorningDate.timeIntervalSince1970))
+                }),
+                ActionSheetButtonItem(title: presentationData.strings.FocusModes_UntilTurnedOff, color: .accent, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                    activate(mode.id, nil)
+                })
+            ]),
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                })
+            ])
+        ])
+        present(actionSheet)
+    }
+
+    if settings.modes.count == 1, let mode = settings.modes.first {
+        chooseDuration(mode)
+        return
+    }
+
+    let actionSheet = ActionSheetController(presentationData: presentationData)
+    var items: [ActionSheetItem] = [ActionSheetTextItem(title: presentationData.strings.FocusModes_ChooseMode)]
+    for mode in settings.modes {
+        items.append(ActionSheetButtonItem(title: mode.title, color: .accent, action: { [weak actionSheet] in
+            actionSheet?.dismissAnimated()
+            chooseDuration(mode)
+        }))
+    }
+    actionSheet.setItemGroups([
+        ActionSheetItemGroup(items: items),
+        ActionSheetItemGroup(items: [
+            ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                actionSheet?.dismissAnimated()
+            })
+        ])
+    ])
+    present(actionSheet)
+}
