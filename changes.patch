diff --git a/submodules/ChatListUI/Sources/FocusModesChatListPresentation.swift b/submodules/ChatListUI/Sources/FocusModesChatListPresentation.swift
new file mode 100644
index 00000000..b4c75181
--- /dev/null
+++ b/submodules/ChatListUI/Sources/FocusModesChatListPresentation.swift
@@ -0,0 +1,73 @@
+import Foundation
+import SwiftSignalKit
+import TelegramPresentationData
+import FocusModes
+import FocusModesSignals
+
+/// The Focus Modes state the chat list shows, which can lag the stored one. The root chat list moves it forward only
+/// while it is on screen, so a mode turned on in Settings, by a schedule or by an iOS Focus hides its chats and folders
+/// in front of the user when they come back, instead of while they were away.
+final class FocusModesChatListPresentation {
+    private static var byAccount: [Int64: FocusModesChatListPresentation] = [:]
+
+    static func forAccount(_ accountPeerId: Int64, rootPath: String) -> FocusModesChatListPresentation {
+        if let current = self.byAccount[accountPeerId] {
+            return current
+        }
+        let result = FocusModesChatListPresentation(rootPath: rootPath)
+        self.byAccount[accountPeerId] = result
+        return result
+    }
+
+    private let promise: ValuePromise<FocusModesState>
+    private(set) var current: FocusModesState
+
+    private init(rootPath: String) {
+        let settings = FocusModesStore.loadSettings(rootPath: rootPath)
+        let systemState = FocusModesStore.loadSystemState(rootPath: rootPath)
+        self.current = FocusModesState(settings: settings, systemState: systemState, activeMode: settings.activeMode(systemState: systemState, at: Date()))
+        self.promise = ValuePromise(self.current, ignoreRepeated: true)
+    }
+
+    var state: Signal<FocusModesState, NoError> {
+        return self.promise.get()
+    }
+
+    func set(_ state: FocusModesState) {
+        self.current = state
+        self.promise.set(state)
+    }
+}
+
+/// "Personal is on" and what it does, for the toast the chat list shows when the active mode changes.
+func focusModesToastText(previous: FocusActiveMode?, current: FocusActiveMode?, accountPeerId: Int64, strings: PresentationStrings) -> (title: String, text: String)? {
+    if let current {
+        let mode = current.mode
+        func describe(_ targets: FocusChatTargets) -> String {
+            var parts = targets.folders.filter { $0.accountPeerId == accountPeerId }.map(\.title)
+            if !targets.peerIds.isEmpty {
+                parts.append(strings.FocusModes_ChatCount(Int32(targets.peerIds.count)))
+            }
+            if parts.count > 1 {
+                return parts.dropLast().joined(separator: ", ") + " \(strings.FocusModes_And) " + parts.last!
+            }
+            return parts.first ?? ""
+        }
+        var sentences: [String] = []
+        if !mode.hidden.isEmpty {
+            sentences.append(strings.FocusModes_ToastHiding(describe(mode.hidden)).string)
+        }
+        if mode.silencesAllChats {
+            sentences.append(strings.FocusModes_ToastMutingAll)
+        } else if !mode.silenced.isEmpty {
+            sentences.append(strings.FocusModes_ToastMuting(describe(mode.silenced)).string)
+        }
+        if sentences.isEmpty {
+            sentences.append(strings.FocusModes_ToastNothing)
+        }
+        return (strings.FocusModes_ToastOnTitle(mode.title).string, sentences.joined(separator: " "))
+    } else if let previous {
+        return (strings.FocusModes_ToastOffTitle(previous.mode.title).string, strings.FocusModes_ToastOffText)
+    }
+    return nil
+}
