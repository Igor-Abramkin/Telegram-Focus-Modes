+func focusTimeString(minute: Int32, dateTimeFormat: PresentationDateTimeFormat) -> String {
+    let hours = Int(minute / 60) % 24
+    let minutes = Int(minute % 60)
+    switch dateTimeFormat.timeFormat {
+    case .regular:
+        let displayHours = hours % 12 == 0 ? 12 : hours % 12
+        return String(format: "%d:%02d %@", displayHours, minutes, hours < 12 ? "AM" : "PM")
+    case .military:
+        return String(format: "%02d:%02d", hours, minutes)
+    }
+}
+
+/// "Weekdays", "Sat, Sun", "Mon, Wed, Fri".
+func focusWeekdaysString(_ weekdays: [Int], strings: PresentationStrings) -> String {
+    let set = Set(weekdays)
+    if set.count == 7 {
+        return strings.FocusModes_EveryDay
+    }
+    if set == Set(FocusSchedule.workdays) {
+        return strings.FocusModes_Weekdays
+    }
+    if set == Set(FocusSchedule.weekend) {
+        return strings.FocusModes_Weekends
+    }
+    let formatter = DateFormatter()
+    formatter.locale = Locale(identifier: strings.baseLanguageCode)
+    let symbols = formatter.shortWeekdaySymbols ?? ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
+    // Monday first.
+    let order = [2, 3, 4, 5, 6, 7, 1]
+    return order.filter { set.contains($0) }.map { symbols[$0 - 1] }.joined(separator: ", ")
+}
+
+func focusScheduleString(_ schedule: FocusSchedule, presentationData: PresentationData) -> (days: String, time: String) {
+    let days = focusWeekdaysString(schedule.weekdays, strings: presentationData.strings)
+    if schedule.isAllDay || schedule.startMinute == schedule.endMinute {
+        return (days, presentationData.strings.FocusModes_AllDay)
+    }
+    return (days, "\(focusTimeString(minute: schedule.startMinute, dateTimeFormat: presentationData.dateTimeFormat)) – \(focusTimeString(minute: schedule.endMinute, dateTimeFormat: presentationData.dateTimeFormat))")
+}
+
+/// "Silences Work and 2 chats. Weekdays 19:00 – 09:00."
+func focusModeSummary(_ mode: FocusMode, presentationData: PresentationData) -> String {
+    let strings = presentationData.strings
+    func describe(_ targets: FocusChatTargets) -> String {
+        var parts: [String] = targets.folders.map(\.title)
+        if !targets.peerIds.isEmpty {
+            parts.append(strings.FocusModes_ChatCount(Int32(targets.peerIds.count)))
+        }
+        if parts.count > 1 {
+            return parts.dropLast().joined(separator: ", ") + " \(strings.FocusModes_And) " + parts.last!
+        } else {
+            return parts.first ?? ""
+        }
+    }
+    var sentences: [String] = []
+    if !mode.hidden.isEmpty {
+        sentences.append(strings.FocusModes_ModeSummaryHides(describe(mode.hidden)).string)
+    }
+    if mode.silencesAllChats {
+        sentences.append(strings.FocusModes_ModeSummaryAll)
+    } else if !mode.silenced.isEmpty {
+        sentences.append(strings.FocusModes_ModeSummarySilences(describe(mode.silenced)).string)
+    }
+    var result = sentences.isEmpty ? strings.FocusModes_ModeSummaryEmpty : sentences.joined(separator: ". ")
+    if let schedule = mode.schedules.first {
+        let (days, time) = focusScheduleString(schedule, presentationData: presentationData)
+        result += ". \(days), \(time)"
+        if mode.schedules.count > 1 {
+            result += " +\(mode.schedules.count - 1)"
+        }
+    }
+    return result
+}
+
+func focusActivationString(_ activeMode: FocusActiveMode, presentationData: PresentationData) -> String {
+    switch activeMode.source {
+    case let .manual(until):
+        if let until {
+            let date = Date(timeIntervalSince1970: Double(until))
+            let calendar = Calendar.current
+            let components = calendar.dateComponents([.hour, .minute], from: date)
+            let time = focusTimeString(minute: Int32((components.hour ?? 0) * 60 + (components.minute ?? 0)), dateTimeFormat: presentationData.dateTimeFormat)
+            return presentationData.strings.FocusModes_SourceManualUntil(time).string
+        } else {
+            return presentationData.strings.FocusModes_SourceManual
+        }
+    case .systemFocus:
+        return presentationData.strings.FocusModes_SourceSystem
+    case .schedule:
+        return presentationData.strings.FocusModes_SourceSchedule
+    }
+}
