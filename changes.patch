+/// The chats a folder holds now: its included chats plus those its chat types (contacts, groups...) bring in.
+func focusResolveFolderPeerIds(context: AccountContext, folder: ChatListFilter) -> Signal<[Int64], NoError> {
+    guard case let .filter(_, _, _, data) = folder else {
+        return .single([])
+    }
+    let explicitPeerIds = data.includePeers.peers.map { $0.toInt64() }
+    if data.categories.isEmpty {
+        return .single(explicitPeerIds)
+    }
+    let predicate = chatListFilterPredicate(filter: data, accountPeerId: context.account.peerId)
+    return context.engine.messages.chatListPeers(group: .root, filterPredicate: predicate, count: 1000)
+    |> take(1)
+    |> map { peers, _ -> [Int64] in
+        var result = explicitPeerIds
+        for peer in peers {
+            let id = peer.id.toInt64()
+            if !result.contains(id) {
+                result.append(id)
+            }
+        }
+        return result
+    }
+}
