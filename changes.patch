+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import ItemListPeerItem
+import ItemListPeerActionItem
+import ChatListUI
+import FocusModes
+import FocusModesSignals
+
+private final class FocusModesControllerArguments {
+    let context: AccountContext
+    let turnOn: () -> Void
+    let turnOff: () -> Void
+    let openMode: (Int32) -> Void
+    let addMode: () -> Void
+    let addAlwaysNotify: () -> Void
+    let removeAlwaysNotifyPeer: (EnginePeer.Id) -> Void
+    let removeAlwaysNotifyFolder: (FocusChatFolder) -> Void
+    let setRevealedItem: (FocusModesEntryId?, FocusModesEntryId?) -> Void
+    let updateShowMuted: (Bool) -> Void
+
+    init(context: AccountContext, turnOn: @escaping () -> Void, turnOff: @escaping () -> Void, openMode: @escaping (Int32) -> Void, addMode: @escaping () -> Void, addAlwaysNotify: @escaping () -> Void, removeAlwaysNotifyPeer: @escaping (EnginePeer.Id) -> Void, removeAlwaysNotifyFolder: @escaping (FocusChatFolder) -> Void, setRevealedItem: @escaping (FocusModesEntryId?, FocusModesEntryId?) -> Void, updateShowMuted: @escaping (Bool) -> Void) {
+        self.context = context
+        self.turnOn = turnOn
+        self.turnOff = turnOff
+        self.openMode = openMode
+        self.addMode = addMode
+        self.addAlwaysNotify = addAlwaysNotify
+        self.removeAlwaysNotifyPeer = removeAlwaysNotifyPeer
+        self.removeAlwaysNotifyFolder = removeAlwaysNotifyFolder
+        self.setRevealedItem = setRevealedItem
+        self.updateShowMuted = updateShowMuted
+    }
+}
+
+private enum FocusModesSection: Int32 {
+    case active
+    case modes
+    case alwaysNotify
+    case display
+}
+
+enum FocusModesEntryId: Hashable {
+    case index(Int)
+    case mode(Int32)
+    case peer(EnginePeer.Id)
+    case folder(Int64, Int32)
+    case hiddenPeer(EnginePeer.Id)
+    case hiddenFolder(Int64, Int32)
+}
+
+private enum FocusModesEntry: ItemListNodeEntry {
+    case activeHeader(String)
+    case activeMode(symbol: FocusModeSymbol?, title: String, label: String)
+    case activeAction(String, isTurnOff: Bool)
+    case activeInfo(String)
+
+    case modesHeader(String)
+    case mode(index: Int, mode: FocusMode, summary: String, label: String)
+    case addMode(String)
+    case modesInfo(String)
+
+    case alwaysNotifyHeader(String)
+    case addAlwaysNotify(String)
+    case alwaysNotifyFolder(index: Int, folder: FocusChatFolder, isRevealed: Bool)
+    case alwaysNotifyPeer(index: Int, peer: EnginePeer, isRevealed: Bool)
+    case alwaysNotifyInfo(String)
+
+    case showMuted(String, Bool)
+    case showMutedInfo(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .activeHeader, .activeMode, .activeAction, .activeInfo:
+            return FocusModesSection.active.rawValue
+        case .modesHeader, .mode, .addMode, .modesInfo:
+            return FocusModesSection.modes.rawValue
+        case .alwaysNotifyHeader, .addAlwaysNotify, .alwaysNotifyFolder, .alwaysNotifyPeer, .alwaysNotifyInfo:
+            return FocusModesSection.alwaysNotify.rawValue
+        case .showMuted, .showMutedInfo:
+            return FocusModesSection.display.rawValue
+        }
+    }
+
+    var stableId: FocusModesEntryId {
+        switch self {
+        case .activeHeader:
+            return .index(0)
+        case .activeMode:
+            return .index(1)
+        case .activeAction:
+            return .index(2)
+        case .activeInfo:
+            return .index(3)
+        case .modesHeader:
+            return .index(4)
+        case let .mode(_, mode, _, _):
+            return .mode(mode.id)
+        case .addMode:
+            return .index(5)
+        case .modesInfo:
+            return .index(6)
+        case .alwaysNotifyHeader:
+            return .index(7)
+        case .addAlwaysNotify:
+            return .index(8)
+        case let .alwaysNotifyFolder(_, folder, _):
+            return .folder(folder.accountPeerId, folder.id)
+        case let .alwaysNotifyPeer(_, peer, _):
+            return .peer(peer.id)
+        case .alwaysNotifyInfo:
+            return .index(9)
+        case .showMuted:
+            return .index(10)
+        case .showMutedInfo:
+            return .index(11)
+        }
+    }
+
+    private var sortIndex: Int {
+        switch self {
+        case .activeHeader:
+            return 0
+        case .activeMode:
+            return 1
+        case .activeAction:
+            return 2
+        case .activeInfo:
+            return 3
+        case .modesHeader:
+            return 100
+        case let .mode(index, _, _, _):
+            return 101 + index
+        case .addMode:
+            return 500
+        case .modesInfo:
+            return 501
+        case .alwaysNotifyHeader:
+            return 600
+        case .addAlwaysNotify:
+            return 601
+        case let .alwaysNotifyFolder(index, _, _):
+            return 700 + index
+        case let .alwaysNotifyPeer(index, _, _):
+            return 2000 + index
+        case .alwaysNotifyInfo:
+            return 9000
+        case .showMuted:
+            return 9100
+        case .showMutedInfo:
+            return 9101
+        }
+    }
+
+    static func <(lhs: FocusModesEntry, rhs: FocusModesEntry) -> Bool {
+        return lhs.sortIndex < rhs.sortIndex
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! FocusModesControllerArguments
+        switch self {
+        case let .activeHeader(text), let .modesHeader(text), let .alwaysNotifyHeader(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .activeMode(symbol, title, label):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: symbol.flatMap { focusModeIcon($0) } ?? focusModeIcon(.doNotDisturb), title: title, titleFont: symbol == nil ? .regular : .bold, label: label, sectionId: self.section, style: .blocks, disclosureStyle: .none, action: nil)
+        case let .activeAction(text, isTurnOff):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: text, kind: isTurnOff ? .destructive : .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                if isTurnOff {
+                    arguments.turnOff()
+                } else {
+                    arguments.turnOn()
+                }
+            })
+        case let .activeInfo(text), let .modesInfo(text), let .alwaysNotifyInfo(text), let .showMutedInfo(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .mode(_, mode, summary, label):
+            return NotificationsCategoryItemListItem(presentationData: presentationData, systemStyle: .glass, icon: focusModeIcon(mode.symbol), title: mode.title, subtitle: summary, label: label, sectionId: self.section, style: .blocks, action: {
+                arguments.openMode(mode.id)
+            })
+        case let .addMode(text):
+            return ItemListPeerActionItem(presentationData: presentationData, systemStyle: .glass, icon: PresentationResourcesItemList.plusIconImage(presentationData.theme), title: text, alwaysPlain: false, sectionId: self.section, height: .generic, editing: false, action: {
+                arguments.addMode()
+            })
+        case let .addAlwaysNotify(text):
